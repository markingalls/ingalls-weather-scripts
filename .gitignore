# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
.mypy_cache/
.ipynb_checkpoints/

# OS cruft
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Secrets / local config
.env
*.local

# --- columbia-basin-alerts-map ---
# alerts_with_zones.json is live data fetch_alerts.py regenerates every run --
# committing it just creates noise. The rendered map images are outputs too,
# not source -- regenerate with build_map.py rather than tracking them.
columbia-basin-alerts-map/alerts_with_zones.json
columbia-basin-alerts-map/columbia_basin_alerts*.png

# --- western-us-noaa-outlooks ---
# build_map.py fetches its source KML/KMZ live; data/ only holds files
# dropped there for a --file override (testing / a source being down), and
# the rendered PNGs are outputs -- neither is source, so don't track them.
western-us-noaa-outlooks/data/*.kml
western-us-noaa-outlooks/data/*.kmz
western-us-noaa-outlooks/output/*.png
# state/ is the droplet-deploy guard's runtime state (lock file, logs) --
# created on the server, not source.
western-us-noaa-outlooks/state/

# --- columbia-basin-temps ---
# build_map.py fetches its source grids live; data/ only holds saved
# snapshots for a --file override (testing / avoiding re-fetching), and the
# rendered PNGs are outputs -- neither is source, so don't track them.
columbia-basin-temps/data/*.npz
columbia-basin-temps/output/*.png

# --- 850-700-temp-chart ---
# forecast.json/climatology.json are live data fetch_forecast.py and
# fetch_climatology.py regenerate every run, and the rendered chart is an
# output too -- neither is source, so don't track them.
850-700-temp-chart/forecast.json
850-700-temp-chart/climatology.json
850-700-temp-chart/wm6_ensemble_spread*.png

# --- columbia-basin-lightning-map ---
# lightning_last24h.json is live data fetch_lightning.py regenerates every
# run, and the rendered map images (one per REGIONS entry: Columbia Basin,
# Portland, Pacific NW, BC Interior) are outputs too -- neither is source,
# so don't track them. state/ is the droplet-deploy guard's runtime state
# (lock file, logs) -- created on the server, not source. basemap_cache/
# holds the cached basemap rasters build_map.py rebuilds automatically
# (self-invalidating, see _basemap_cache_key) -- regenerable build output,
# same as the rendered PNGs, not source.
columbia-basin-lightning-map/lightning_last24h.json
columbia-basin-lightning-map/*_lightning.png
columbia-basin-lightning-map/state/
columbia-basin-lightning-map/basemap_cache/

# --- columbia-basin-lightning-realtime-map ---
# same reasoning as columbia-basin-lightning-map above.
columbia-basin-lightning-realtime-map/lightning_last2h.json
columbia-basin-lightning-realtime-map/*_lightning_realtime.png
columbia-basin-lightning-realtime-map/state/

# --- columbia-basin-lightning-daily-map ---
# lightning_daily.json is live data fetch_lightning.py regenerates every
# run. The published day1-5 images normally live on the droplet's
# WEB_ROOT, not here, but a local test run writes them next to this repo
# checkout -- neither is source, so don't track them. state/ is the
# droplet-deploy guard's runtime state (lock file, logs, and the
# last-rotation-date marker publish_daily.py's idempotency depends on) --
# created on the server, not source.
columbia-basin-lightning-daily-map/lightning_daily.json
columbia-basin-lightning-daily-map/*_lightning_day*.png
columbia-basin-lightning-daily-map/state/

# --- dew-point-storm-map ---
# build_map.py fetches its source grids live; output/ only holds saved
# snapshots for a --file override (testing / avoiding re-fetching), and the
# rendered PNGs are outputs -- neither is source, so don't track them.
dew-point-storm-map/output/*.npz
dew-point-storm-map/output/*.png

# --- wildcad-fires-map ---
# build_map.py fetches live fire data; output/ only holds saved snapshots
# for a --file override (testing / avoiding re-fetching), and the rendered
# PNGs are outputs -- neither is source, so don't track them.
wildcad-fires-map/output/*.json
wildcad-fires-map/output/*.png

# --- hrrr-smoke-chart ---
# smoke.json is live data fetch_smoke.py regenerates every run, and the
# rendered chart is an output too -- neither is source, so don't track them.
hrrr-smoke-chart/smoke.json
hrrr-smoke-chart/hrrr_*_smoke_*.png
# --- tri-cities-7day-forecast ---
# forecast.json/metamesh_forecast.json/openmeteo_forecast.json are live data
# the fetch_*.py scripts regenerate every run, and the rendered graphic is
# an output too -- neither is source, so don't track them.
tri-cities-7day-forecast/forecast.json
tri-cities-7day-forecast/metamesh_forecast.json
tri-cities-7day-forecast/openmeteo_forecast.json
tri-cities-7day-forecast/ecmwf_ensemble_forecast.json
tri-cities-7day-forecast/hrrr_smoke_forecast.json
tri-cities-7day-forecast/tri_cities_7day_forecast*.png
# state/ is the droplet-deploy guard's runtime state (last-seen ECMWF run,
# lock file, logs) -- created on the server, not source.
tri-cities-7day-forecast/state/
# --- tri-cities-temp-chart ---
# observed.json/forecast.json/climatology.json are live data the fetch_*.py
# scripts regenerate every run, and the rendered chart is an output too --
# neither is source, so don't track them.
tri-cities-temp-chart/observed.json
tri-cities-temp-chart/forecast.json
tri-cities-temp-chart/climatology.json
tri-cities-temp-chart/tri_cities_temp_chart*.png
# --- tpw-wm6-ensemble-map ---
# build_map.py fetches its source grid live; output/ only holds saved
# snapshots for a --file override (testing / avoiding re-fetching), and the
# rendered PNGs are outputs -- neither is source, so don't track them.
tpw-wm6-ensemble-map/output/*.npz
tpw-wm6-ensemble-map/output/*.png

# --- columbia-basin-alerts-map ---
# fetch_alerts.py fetches its source live every run, and the rendered PNGs
# are outputs -- neither is source, so don't track them. state/ is the
# droplet-deploy guard's runtime state (lock file, logs) -- created on the
# server, not source.
columbia-basin-alerts-map/alerts_with_zones.json
columbia-basin-alerts-map/*.png
columbia-basin-alerts-map/state/

# --- image-hit-stats ---
# hits.sqlite3/cursor.json are runtime state built up on the server from
# nginx's own access log, not source -- there's nothing to check in here
# that a fresh deploy couldn't regenerate from scratch (starting the hit
# count over at zero, same as the very first deploy).
image-hit-stats/state/
