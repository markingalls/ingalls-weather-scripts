# Add these lines to the droplet's existing crontab (crontab -e) alongside
# the tri-cities-7day-forecast lines already there. No new env vars needed
# here -- none of these products require an API key.
#
# Each line's time is NOAA's own real issuance schedule for that product
# group (confirmed against SPC/CPC's own published schedules, not guessed),
# plus roughly 10-15 min buffer for the file to actually post -- see
# NOAA_SCHEDULE.md in this folder for the sourcing on each one.

# --- SPC Day 1 (categorical + tornado + wind + hail): 5x/day, 0600Z/1300Z/1630Z/2000Z/0100Z ---
15 6 * * *  /opt/ingalls-weather-scripts/western-us-noaa-outlooks/venv/bin/python3 /opt/ingalls-weather-scripts/western-us-noaa-outlooks/deploy/publish_outlooks.py --products spc_severe,spc_tornado_day1,spc_wind_day1,spc_hail_day1 >> /opt/ingalls-weather-scripts/western-us-noaa-outlooks/state/cron.log 2>&1
15 13 * * * /opt/ingalls-weather-scripts/western-us-noaa-outlooks/venv/bin/python3 /opt/ingalls-weather-scripts/western-us-noaa-outlooks/deploy/publish_outlooks.py --products spc_severe,spc_tornado_day1,spc_wind_day1,spc_hail_day1 >> /opt/ingalls-weather-scripts/western-us-noaa-outlooks/state/cron.log 2>&1
45 16 * * * /opt/ingalls-weather-scripts/western-us-noaa-outlooks/venv/bin/python3 /opt/ingalls-weather-scripts/western-us-noaa-outlooks/deploy/publish_outlooks.py --products spc_severe,spc_tornado_day1,spc_wind_day1,spc_hail_day1 >> /opt/ingalls-weather-scripts/western-us-noaa-outlooks/state/cron.log 2>&1
15 20 * * * /opt/ingalls-weather-scripts/western-us-noaa-outlooks/venv/bin/python3 /opt/ingalls-weather-scripts/western-us-noaa-outlooks/deploy/publish_outlooks.py --products spc_severe,spc_tornado_day1,spc_wind_day1,spc_hail_day1 >> /opt/ingalls-weather-scripts/western-us-noaa-outlooks/state/cron.log 2>&1
15 1 * * *  /opt/ingalls-weather-scripts/western-us-noaa-outlooks/venv/bin/python3 /opt/ingalls-weather-scripts/western-us-noaa-outlooks/deploy/publish_outlooks.py --products spc_severe,spc_tornado_day1,spc_wind_day1,spc_hail_day1 >> /opt/ingalls-weather-scripts/western-us-noaa-outlooks/state/cron.log 2>&1

# --- SPC Day 2 (categorical + tornado + wind + hail): 2x/day, ~0600-0700Z and 1730Z ---
15 7 * * *  /opt/ingalls-weather-scripts/western-us-noaa-outlooks/venv/bin/python3 /opt/ingalls-weather-scripts/western-us-noaa-outlooks/deploy/publish_outlooks.py --products spc_convective_day2,spc_tornado_day2,spc_wind_day2,spc_hail_day2 >> /opt/ingalls-weather-scripts/western-us-noaa-outlooks/state/cron.log 2>&1
45 17 * * * /opt/ingalls-weather-scripts/western-us-noaa-outlooks/venv/bin/python3 /opt/ingalls-weather-scripts/western-us-noaa-outlooks/deploy/publish_outlooks.py --products spc_convective_day2,spc_tornado_day2,spc_wind_day2,spc_hail_day2 >> /opt/ingalls-weather-scripts/western-us-noaa-outlooks/state/cron.log 2>&1

# --- SPC Day 3 (categorical only -- no separate wind/hail product): 2x/day, ~0730-0830Z and 1930Z ---
45 8 * * *  /opt/ingalls-weather-scripts/western-us-noaa-outlooks/venv/bin/python3 /opt/ingalls-weather-scripts/western-us-noaa-outlooks/deploy/publish_outlooks.py --products spc_convective_day3 >> /opt/ingalls-weather-scripts/western-us-noaa-outlooks/state/cron.log 2>&1
45 19 * * * /opt/ingalls-weather-scripts/western-us-noaa-outlooks/venv/bin/python3 /opt/ingalls-weather-scripts/western-us-noaa-outlooks/deploy/publish_outlooks.py --products spc_convective_day3 >> /opt/ingalls-weather-scripts/western-us-noaa-outlooks/state/cron.log 2>&1

# --- SPC Fire Weather (Day 1 + Day 2 share one AM issuance, then separate PM updates) ---
15 8 * * *  /opt/ingalls-weather-scripts/western-us-noaa-outlooks/venv/bin/python3 /opt/ingalls-weather-scripts/western-us-noaa-outlooks/deploy/publish_outlooks.py --products spc_fire,spc_fire_day2 >> /opt/ingalls-weather-scripts/western-us-noaa-outlooks/state/cron.log 2>&1
15 17 * * * /opt/ingalls-weather-scripts/western-us-noaa-outlooks/venv/bin/python3 /opt/ingalls-weather-scripts/western-us-noaa-outlooks/deploy/publish_outlooks.py --products spc_fire >> /opt/ingalls-weather-scripts/western-us-noaa-outlooks/state/cron.log 2>&1
15 20 * * * /opt/ingalls-weather-scripts/western-us-noaa-outlooks/venv/bin/python3 /opt/ingalls-weather-scripts/western-us-noaa-outlooks/deploy/publish_outlooks.py --products spc_fire_day2 >> /opt/ingalls-weather-scripts/western-us-noaa-outlooks/state/cron.log 2>&1

# --- CPC 6-10 Day + 8-14 Day (temp + precip): daily, issued 3-4pm Eastern ---
0 21 * * *  /opt/ingalls-weather-scripts/western-us-noaa-outlooks/venv/bin/python3 /opt/ingalls-weather-scripts/western-us-noaa-outlooks/deploy/publish_outlooks.py --products temp_6_10,precip_6_10,temp_8_14,precip_8_14 >> /opt/ingalls-weather-scripts/western-us-noaa-outlooks/state/cron.log 2>&1

# --- CPC Week 3-4 (temp + precip): weekly, Fridays 3-4pm Eastern ---
0 21 * * 5  /opt/ingalls-weather-scripts/western-us-noaa-outlooks/venv/bin/python3 /opt/ingalls-weather-scripts/western-us-noaa-outlooks/deploy/publish_outlooks.py --products temp_wk34,precip_wk34 >> /opt/ingalls-weather-scripts/western-us-noaa-outlooks/state/cron.log 2>&1

# --- U.S. Drought Monitor: weekly, Thursdays ---
0 14 * * 4  /opt/ingalls-weather-scripts/western-us-noaa-outlooks/venv/bin/python3 /opt/ingalls-weather-scripts/western-us-noaa-outlooks/deploy/publish_outlooks.py --products drought_monitor >> /opt/ingalls-weather-scripts/western-us-noaa-outlooks/state/cron.log 2>&1
